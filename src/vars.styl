// Screen breakpoints & dimensions
small-screen = 640px;
desktop-controls-width = 448px;

// Chronicle Design System - Typographic Polarity
serif-font = 'Playfair Display', 'Noto Serif SC', Georgia, serif;
sans-font = 'Plus Jakarta Sans', 'Noto Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
labels-font = serif-font;

// Chronicle Design System - Semantic Color Tokens
base-surface = #fbf9f6;
dark-surface = #1c1f26;
primary-ink = #3d4451;
dark-primary-ink = #d2d6dd;
secondary-ink = #757d8a;
dark-secondary-ink = #a0a7b4;
sole-accent = #82a1b9;
dark-sole-accent = #9cb4cd;

// Subtle Structural Tokens (Decoupled overlays & hairlines)
subtle-border = rgba(61, 68, 81, 0.16);
subtle-fill = rgba(61, 68, 81, 0.06);
stroke-tint = rgba(61, 68, 81, 0.60);
glass-surface = rgba(251, 249, 246, 0.88);
glass-blur = 12px;

// Backward-compatible token mappings
highlight-color = sole-accent;
primary-text = primary-ink;
secondary-color = secondary-ink;
emphasis-background = base-surface;
background-color = base-surface;
border-color = subtle-border;
